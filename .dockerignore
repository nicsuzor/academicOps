# Ignore everything by default
**

# Allow .git for versioning (P#93 / uv-dynamic-versioning)
!/.git
!/.git/**

# Allow project files
!/pyproject.toml
!/uv.lock
!/README.md
!/LICENSE
!/Makefile

# Allow source code. lib/ carries polecat's entrypoint and baked container
# defaults, which the image COPYs directly from the build context.
!/lib/**
!/plugins/**
!/scripts/**
!/specs/**
!/tests/**
!/templates/**

# Re-ignore unnecessary files in allowed directories
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.coverage
**/htmlcov
**/dist
# Root-level dist/ is the built framework output, needed by the Dockerfile's
# aops-dist-local stage (AOPS_DIST_SOURCE=local, used by `make build-docker`
# for local dev builds — see Dockerfile). Nested dist dirs (.venv/, worktrees,
# node_modules) stay excluded via the blanket rule above.
!/dist/**
**/node_modules
**/.venv
**/.agent
**/.claude
**/.gemini
**/.aops
**/.polecat
