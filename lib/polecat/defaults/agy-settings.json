{
  "trustedWorkspaces": [
    "/workspace"
  ],
  "permissions": {
    "allow": [
      "mcp(services/*)",
      "read_file(/workspace/*)",
      "write_file(/workspace/*)",
      "command(git *)",
      "command(make *)",
      "command(*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agystatusline",
    "padding": 0
  }
}
