{
  "showFeedbackSurvey": false,
  "trustedWorkspaces": [
    "/workspace",
    "/tmp",
    "/home/worker"
  ],
  "permissions": {
    "allow": [
      "mcp(*)",
      "read_file(*)",
      "write_file(*)",
      "command(*)",
      "read_url(*)",
      "execute_url(*)",
      "define_subagent",
      "find_by_name",
      "finish",
      "generate_image",
      "grep_search",
      "invoke_subagent",
      "list_dir",
      "manage_subagents",
      "manage_task",
      "notebook_edit",
      "read_url_content",
      "replace_file_content",
      "run_command",
      "schedule",
      "search_web",
      "send_message",
      "view_file",
      "wait",
      "write_to_file"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agystatusline",
    "padding": 0
  }
}
