{
  "trustedWorkspaces": [
    "/workspace",
    "/tmp",
    "/home/worker"
  ],
  "permissions": {
    "allow": [
      "mcp(*)",
      "read_file(*)",
      "write_file(*)",
      "command(*)",
      "read_url(*)",
      "execute_url(*)",
      "unsandboxed(*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "agystatusline",
    "padding": 0
  }
}
