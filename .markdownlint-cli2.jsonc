{
  // dprint is the only markdown formatter. Every whitespace, list, heading,
  // emphasis, code-fence and table rule is dprint's; markdownlint carries only
  // the house rules and the semantic checks dprint cannot make. Adding a
  // formatting rule here reintroduces the fight and will be reverted.
  "noBanner": true,
  "noProgress": true,
  "config": {
    "default": false,

    // House rule (.markdownlint-rules/), auto-fixable. Em-dashes are handled
    // by scripts/no_em_dashes.py, which can also reach YAML frontmatter.
    "no-horizontal-rules": true,

    // Semantics, not layout.
    "MD001": true, // heading levels increment by one
    "MD024": { "siblings_only": true }, // duplicate headings under one parent
    "MD026": true, // trailing punctuation in a heading
    "MD042": true, // empty links
    "MD045": true, // images without alt text
    "MD051": true, // link fragments that resolve to no heading
    "MD052": true, // undefined reference links
    "MD053": true // unused link definitions
  },
  "customRules": [".markdownlint-rules/no-horizontal-rules.js"],
  // Mirrors dprint.json excludes: the snapshot fixtures are byte-exact
  // expectations and must never be reformatted.
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".agents/**",
    ".aops/**",
    ".polecat/**",
    ".venv/**",
    ".claude/**",
    "**/archived/**",
    "dist/**",
    "tests/transcripts/fixtures/**"
  ]
}
