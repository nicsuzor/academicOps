{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:system",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "files.associations": {
        ".yml": "yaml",
        ".yaml": "yaml"
    },
    // Python - ruff
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Markdown - dprint for formatting, markdownlint for linting
    "[markdown]": {
        "editor.defaultFormatter": "dprint.dprint",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[jsonl]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[toml]": {
        "editor.defaultFormatter": "bodil.prettier-toml",
        "editor.formatOnSave": true
    },
    // Markdownlint - enable inline
    "markdownlint.run": "onType",
    "python.languageServer": "None",
    "python.analysis.typeCheckingMode": "off",
    "basedpyright.analysis.typeCheckingMode": "strict",
    // Make strict mode less annoying 👇
    "basedpyright.analysis.diagnosticSeverityOverrides": {
        // Downgrade overly noisy strict rules
        "reportMissingTypeStubs": "none",
        "reportUnknownMemberType": "warning",
        "reportUnknownVariableType": "warning",
        "reportUnknownArgumentType": "warning",
        "reportUnknownLambdaType": "none",
        // Reduce friction while prototyping
        "reportMissingParameterType": "none",
        "reportMissingArgumentType": "none",
        // Keep useful correctness checks strong
        "reportOptionalMemberAccess": "error",
        "reportOptionalSubscript": "error",
        "reportOptionalCall": "error",
        // Cleanliness (strict but reasonable)
        "reportUnusedVariable": "warning",
        "reportUnusedImport": "warning",
        // Avoid over-strictness in dynamic code
        "reportAny": "none",
        "reportExplicitAny": "none"
    },
    // Performance / UX tweaks
    "basedpyright.analysis.autoSearchPaths": true,
    "basedpyright.analysis.useLibraryCodeForTypes": true
}
