<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent: export aops env vars into the per-user launchd context
  so GUI-launched processes (Claude.app -> Claude Code / Cowork tabs) inherit
  them. Interactive terminal shells do NOT need this -- they read ~/.env.local.

  This exports the bot PAT, AOPS directory vars, the GENAI_ENGINE_* tracing
  vars and the Cloudflare Access service tokens (GENAI_ENGINE_API_KEY for
  https://otel.suzor.com, PKB_MCP_TOKEN for the MCP portal) globally (see
  launchd-env.sh for the exact whitelist). Secrets come from the sops SSoT
  that launchd-env.sh decrypts; ~/.env and ~/.env.local never hold them. It does NOT set
  any global SSH lockdown or git-config hijack -- that would re-break VS Code
  and other GUI apps (note-4d4a97c2). Session-scoped credential isolation for
  Claude/bot sessions is applied per-session by the aops plugin's SessionStart
  hook.

  Install:

```sh
cp scripts/macos-launchd/com.aops.envvars.plist ~/Library/LaunchAgents/
cp scripts/macos-launchd/launchd-env.sh        "$POLECAT_HOME/launchd-env.sh"  # default ~/.aops/
launchctl unload ~/Library/LaunchAgents/com.aops.envvars.plist
launchctl load ~/Library/LaunchAgents/com.aops.envvars.plist
launchctl kickstart -k gui/$(id -u)/com.aops.envvars  # forces RunAtLoad
```

  Verify (token is masked):
      launchctl getenv AOPS_SESSIONS
      launchctl getenv GH_TOKEN | awk '{ if (length($0)) print "set, len="length($0); else print "UNSET" }'
      launchctl getenv GENAI_ENGINE_TRACE_ENDPOINT   # expect https://otel.suzor.com/v1/traces (from ~/.env)
      launchctl getenv GENAI_ENGINE_TRACE_PROTOCOL
      launchctl getenv GENAI_ENGINE_TASK_ID
      launchctl getenv GENAI_ENGINE_API_KEY | awk '{ if (length($0)) print "set, len="length($0); else print "UNSET" }'  # CF Access token for otel.suzor.com
      launchctl getenv PKB_MCP_TOKEN        | awk '{ if (length($0)) print "set, len="length($0); else print "UNSET" }'  # CF Access token for the MCP portal
  If either token is UNSET while a terminal `echo ${GENAI_ENGINE_API_KEY:+set}`
  says set, sops did not run under launchd: check
  `log show --last 10m --predicate 'process == "logger"' | grep com.aops.envvars`
  and that sops is on /opt/homebrew/bin or /usr/local/bin and
  ~/.config/sops/age/keys.txt holds this Mac's age key.
  Restart Claude.app fully (quit, not just close-window) after install/update --
  launchctl setenv only reaches processes launched after it runs.

  Update:
      Edit either file -> unload+load -> kickstart -> fully quit Claude.app.

  Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.aops.envvars.plist
      launchctl unsetenv AOPS_SESSIONS POLECAT_HOME ACA_DATA \
                         GH_TOKEN GITHUB_TOKEN AOPS_BOT_GH_TOKEN \
                         GENAI_ENGINE_API_KEY PKB_MCP_TOKEN
      rm ~/Library/LaunchAgents/com.aops.envvars.plist

  Paths used:
    $HOME/.env              -- dotfiles-managed shared config: defines
                               AOPS_SERVICES_HOST and derives
                               GENAI_ENGINE_TRACE_ENDPOINT from it
                               ("http://$AOPS_SERVICES_HOST:4316"). Sourced
                               first so .env.local can override.
    $HOME/.env.local        -- single machine-local source of truth: exports
                               AOPS_SESSIONS, POLECAT_HOME, ACA_DATA, and the
                               bot PAT (AOPS_BOT_GH_TOKEN). No machine-specific
                               paths live in this committed plist.
    $HOME/dotfiles/secrets/aops-secrets.env
                            -- sops/age-encrypted secret SSoT (AOPS_BOT_GH_TOKEN,
                               GENAI_ENGINE_API_KEY, PKB_MCP_TOKEN, ...).
                               Decrypted in memory by launchd-env.sh, mirroring
                               dotfiles/.zsh/01-env.zsh and scripts/cron-lib.sh.
                               Plaintext never lands on disk or in this plist.
    ${POLECAT_HOME:-$HOME/.aops}/launchd-env.sh
                            -- bot PAT + directory + tracing pass-through:
                               decrypts the sops SSoT, then does all the
                               launchctl setenv from the environment that
                               ~/.env, ~/.env.local and the SSoT
                               established (see launchd-env.sh). It forwards
                               GENAI_ENGINE_TRACE_ENDPOINT/PROTOCOL/TASK_ID
                               only if they are already set by ~/.env -- if
                               `launchctl getenv GENAI_ENGINE_TRACE_PROTOCOL`
                               or `...TASK_ID` come back empty after install,
                               add those two vars to ~/.env (dotfiles), not to
                               this plist or to ~/.claude/settings.json.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aops.envvars</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>[ -f "$HOME/.env" ] &amp;&amp; . "$HOME/.env"; [ -f "$HOME/.env.local" ] &amp;&amp; . "$HOME/.env.local"; [ -f "${POLECAT_HOME}/launchd-env.sh" ] &amp;&amp; . "${POLECAT_HOME}/launchd-env.sh"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
