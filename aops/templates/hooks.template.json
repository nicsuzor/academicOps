{
  "claude": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude SessionStart'"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude Stop'"
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude SubagentStop'"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude UserPromptSubmit'"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude PostToolUse'"
            }
          ]
        }
      ]
    }
  },
  "antigravity": {
    "hooks": {
      "PostInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${AGY_PLUGIN_ROOT}/hooks/router.py\" agy PostInvocation'"
            }
          ]
        }
      ],
      "PreInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${AGY_PLUGIN_ROOT}/hooks/router.py\" agy PreInvocation'"
            }
          ]
        }
      ]
    }
  }
}
