{
  "claude": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'source \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-path.sh\" >/dev/null 2>&1 || true; uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude SessionStart'"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "uv",
              "args": ["run", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/gate_dispatch.py", "claude"]
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "uv",
              "args": ["run", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/gate_dispatch.py", "claude"]
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'source \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-path.sh\" >/dev/null 2>&1 || true; uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude SubagentStop'"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'source \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-path.sh\" >/dev/null 2>&1 || true; uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude UserPromptSubmit'"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'source \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-path.sh\" >/dev/null 2>&1 || true; uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/router.py\" claude PostToolUse'"
            }
          ]
        }
      ]
    }
  },
  "antigravity": {
    "hooks": {
      "PostInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${AGY_PLUGIN_ROOT}/hooks/router.py\" agy PostInvocation'"
            }
          ]
        }
      ],
      "PreInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash -c 'uv run python \"${AGY_PLUGIN_ROOT}/hooks/router.py\" agy PreInvocation'"
            }
          ]
        }
      ]
    }
  }
}
