# polecat.yaml — operational config for EVERY surface (face/interactive,
# crew, worker, subagent). Single posture source (note_296e5520 §4).
#
# Copy this file to $AOPS_SESSIONS/polecat.yaml and edit to taste.
# Loaded by aops-core/lib/polecat_config.py — that module is the SSoT for
# the schema; consult its docstring for field semantics.
#
# This file is the ONLY place these knobs are configured. DEFAULTS-NONE is
# UNIVERSAL: there are no legacy env-var fallbacks and no built-in code
# defaults anywhere — missing fields hard-fail at load time, for every
# surface, including a bare direct/interactive CLI session with no polecat
# launcher involved (aops-core/hooks/gate_config.py resolves this file's
# `face` section directly in that case; see its module docstring).

# ---------------------------------------------------------------------------
# polecat_home — REQUIRED. Local cache root for worktrees, sessions/,
# local.yaml, polecats/ transcripts, and the bare repo mirror. The single
# source of truth, read on the host by lib/polecat_config.resolve_polecat_home
# (consumed by polecat/manager.py). Supports ~ and ${VAR} expansion.
#
# No default, no env fallback, no guessing: if this key is missing the loader
# hard-fails (A14). The host resolves it and injects POLECAT_HOME into
# containers; the container itself reads no config. The `polecat --home PATH`
# CLI flag overrides it for a single invocation.
# ---------------------------------------------------------------------------
polecat_home: ~/.polecat

# ---------------------------------------------------------------------------
# FOUR EXPLICIT PER-SURFACE SECTIONS — face, crew, worker, subagent.
#
# No overlay, no inheritance, no shared "defaults" base: each section below
# spells out EVERY key in full, independently of its siblings. This is
# deliberate (note_296e5520 §4, "explicit per-surface sections, no overlay/
# defaults naming") — a missing key in any ONE section fails config load for
# ALL surfaces, so nobody discovers a hole by being the first to hit it.
#
#   face      Direct/interactive CLI sessions — a bare `claude` or `gemini`
#             invocation with no polecat launcher involved (incl. the WSL
#             orchestrator's own posture). Resolved either by a launcher (n/a
#             here) or, when absent, directly by gate_config.py's own
#             fallback (see its module docstring) / session_env_setup.py's
#             SessionStart hook.
#   crew      `polecat crew` interactive multi-agent sessions (incl. the WSL
#             crew container). Resolved on the host by polecat/cli.py at
#             dispatch and staged into the container as env vars.
#   worker    `polecat run` autonomous headless workers. Same resolution
#             path as crew, different dispatch subcommand.
#   subagent  Task-tool-dispatched subagents. Config-schema section exists
#             and is validated identically to the other three; how it is
#             actually consumed at runtime is a gate-engine/dispatch concern,
#             not a config-loading one (out of scope for this file's SSoT
#             role — see aops-core/lib/gates/definitions.py + GATES.md
#             "Subagent & worker session scope").
#
# Each section's shape:
#   hooks_enabled: bool                   # legacy field, must be true (#940)
#   claude_model: str                     # model id passed to `claude --model`
#   gemini_model: str                     # model id passed to `gemini --model`
#   antigravity_model: str                # model id passed to `agy --model`
#   debug: bool                           # forwarded as DEBUG_HOOKS=1
#   gates:
#     handover: warn|block|off
#     qa: warn|block|off
#     rbg: warn|block|off
#     hydration: warn|block|off
#     ida: warn|block|off
#     rbg_review: warn|block|off
#     rbg_threshold: int
#
# `--model claude`/`gemini`/`antigravity` (provider alias) resolves to
# `<client>_model` for the DISPATCHED surface at runtime — the single source
# of truth for the default model per surface. `--model <literal-id>` overrides
# it in-process for one invocation without mutating this file.
# ---------------------------------------------------------------------------

face:
  hooks_enabled: true
  claude_model: sonnet
  gemini_model: gemini-3.1-pro-preview
  antigravity_model: agy
  debug: false
  gates:
    # Bare/ad hoc direct-CLI sessions: fully quiet posture (matches the
    # PRE-existing built-in `gate_config.py` defaults this section replaces
    # — every gate "off"). Operators who want an interactive session to
    # actually enforce anything (warn/block) should edit this section, or
    # rely on the `crew`/`worker` sections for task-bound dispatch, which
    # DO enforce by default.
    #
    # ida: warn — the ONE exception. This is the face-scoped honesty gate
    # (aops_5ea32596 / note_296e5520 §3): the head/interactive surface is
    # exactly what it exists to protect, and under DEFAULTS-NONE there is no
    # more code-level fallback to supply this — this value IS what
    # gate_config.py's bare-CLI resolution reads. `crew`/`worker`/`subagent`
    # below all set it "off" (structurally absent on every dispatched
    # surface).
    handover: off
    qa: off
    rbg: off
    hydration: off
    ida: warn
    rbg_review: off
    rbg_threshold: 50

crew:
  hooks_enabled: true
  claude_model: sonnet
  gemini_model: gemini-3.1-pro-preview
  antigravity_model: agy
  debug: false
  gates:
    # Task-bound multi-agent sessions: handover + rbg_review block on exit.
    handover: block
    qa: warn
    rbg: warn
    hydration: off
    ida: off
    rbg_review: block
    rbg_threshold: 50

worker:
  hooks_enabled: true
  claude_model: sonnet
  gemini_model: gemini-3.1-pro-preview
  antigravity_model: agy
  debug: false
  gates:
    # Autonomous headless workers: no human present to action a warn, so
    # handover + rbg_review both block.
    handover: block
    qa: warn
    rbg: warn
    hydration: off
    ida: off
    rbg_review: block
    rbg_threshold: 50

subagent:
  hooks_enabled: true
  claude_model: sonnet
  gemini_model: gemini-3.1-pro-preview
  antigravity_model: agy
  debug: false
  gates:
    handover: warn
    qa: warn
    rbg: warn
    hydration: off
    ida: off
    rbg_review: block
    rbg_threshold: 50

# ---------------------------------------------------------------------------
# Docker runtime config. The ssh / unix daemon endpoint is read by the
# docker SDK from $DOCKER_HOST (load-bearing for the SDK; not duplicated
# here).
# ---------------------------------------------------------------------------
docker:
  image: ghcr.io/nicsuzor/aops-crew

# ---------------------------------------------------------------------------
# container_env_forward — the EXPLICIT forwarding whitelist.
#
# The canonical, legible "limited list" of env-var NAMES that cross into
# polecat / crew containers for secrets the launching agent deliberately does
# NOT hold in its own session env (the Claude/Gemini OAuth tokens).
#
# IMPORTANT: list var NAMES only — NEVER values. The polecat launcher resolves
# each name's VALUE at launch from the PROCESS ENVIRONMENT only — AOPS reads no
# files (no sops, no ~/.env.local); the operator populates the env. This is how
# a general agent
# (junior) can dispatch a worker that authenticates with these tokens WITHOUT
# the agent's own session ever holding them (the leak is closed at the agent;
# the container still gets what it needs via this list). A `=` in any entry is
# rejected at load time as a guard against pasting secret values here.
#
# SOURCE-NAME INDIRECTION (aops-b368109a): the names below are the CONTAINER
# names (what the agent runtime reads). A name may be sourced from a DIFFERENT
# host variable — see lib/host_secrets._FORWARD_SOURCE_ALIASES. Current
# indirections:
#   CLAUDE_CODE_OAUTH_TOKEN → sourced from AOPS_CC_OAUTH_TOKEN on the host
#   GH_TOKEN                → sourced from AOPS_BOT_GH_TOKEN on the host
#   GITHUB_TOKEN            → sourced from AOPS_BOT_GH_TOKEN on the host
# The official/container name is kept as a transitional fallback in each case.
# The list still carries the CONTAINER name (no `=`, no value) — the guard
# stays intact; the indirection lives in code, not in this tracked file.
#
# GEMINI symmetry (recommendation, NOT yet wired): once the host var is renamed,
# add `"GEMINI_API_KEY": ("AOPS_GEMINI_API_KEY",)` to that alias map. This list
# is unchanged either way.
container_env_forward:
  - CLAUDE_CODE_OAUTH_TOKEN
  - AGY_API_KEY
  - AOPS_CC_OAUTH_TOKEN
  - GEMINI_API_KEY
  - AOPS_BOT_GH_TOKEN
  - GH_TOKEN
  - GITHUB_TOKEN

# ---------------------------------------------------------------------------
# External agents available for dispatch (github actions, jules, codex, ...).
# Hand-maintained — no auto-discovery. The set of keys here is the
# authoritative provider list consumed by lib/session_naming.py for
# artifact-filename parsing.
# ---------------------------------------------------------------------------
external_agents:
  github:
    enabled: true
    workflows:
      - agent-enforcer
      - agent-merge-prep
      - agent-qa
      - sleep-cycle
  jules:
    enabled: true
  codex:
    enabled: false
  copilot:
    enabled: false

# ---------------------------------------------------------------------------
# PER-MACHINE OVERLAY — <polecat_home>/local.yaml (NOT this file; untracked,
# machine-specific). Optional. Loaded on the host by lib/polecat_config and
# folded into the resolved config. Recognised keys:
#
#   paths:    {<slug>: /abs/path}   # per-machine project path overrides
#   machine:  <short-name>          # → injected into containers as AOPS_MACHINE
#                                     (artifact filenames; replaces the loose
#                                      AOPS_MACHINE outer-env var)
#   gates:    {<name>: warn|block|off}  # partial gate overrides applied
#                                         UNIFORMLY to all four surfaces
#                                         (face/crew/worker/subagent) above,
#                                         for THIS machine only. Distinct
#                                         from the per-surface sections: this
#                                         is a machine-scoped tweak, not a
#                                         posture definition.
#
# This is where per-machine knobs that used to be loose outer-env vars now
# live. The host resolves them; containers receive only the resolved values.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Project registry (read by polecat/manager.py).
# Each entry maps a slug to a GitHub repo + per-project metadata. Slugs are
# the canonical names; aliases below let `polecat crew <alias>` resolve.
#
# Project entries support:
#   repo: <name>            # Optional repository name on GitHub
#   default_branch: <name>  # Default branch (e.g. main, dev)
#   aliases: [...]          # Shorthand names accepted by CLI
#   sessions_access: true   # (Optional) Mount read-only sessions transcripts
#                           # directory and set $AOPS_SESSIONS.
#   mounts:                 # List of additional bind mounts
#   is_repo: false          # (Optional) Set to false for non-repository projects
#                           # to skip git sync and PR state checks.
# ---------------------------------------------------------------------------
projects:
  aops:
    repo: academicOps
    default_branch: main
    aliases: [academicOps, acaops]
  sessions:
    repo: sessions
    default_branch: main
  junior:
    repo: junior

# Top-level shorthand aliases. Highest priority over per-project aliases.
project_aliases:
  ao: aops

# Crew name pool. `polecat crew --name X` overrides; otherwise a name is
# drawn at random from this list.
crew_names:
  - crew

# ===========================================================================
# MASTER ENVIRONMENT-VARIABLE INVENTORY
# ===========================================================================
#
# This is the authoritative list of every environment variable the framework
# reads or writes. polecat.yaml is the SSoT for *config values* (gates, model,
# debug, docker image); env vars are reserved for things that genuinely need
# to be env: filesystem paths, secrets, runtime context injected by the host
# (Claude Code / Gemini CLI / shell), and signals propagated to subprocesses.
#
# When you add a new env var, add it here. When you migrate a knob into the
# YAML schema above, delete its row here. If a row exists below, it is real;
# if it does not exist below, the framework does not read it.
#
# ─── Path locators (host shell sets these in ~/.zshenv / ~/.bashrc) ────────
#
#   AOPS                  Path to academicOps repo. Used by install/bootstrap.
#                         Set by setup.sh and Dockerfile.
#   AOPS_SESSIONS         Path to sessions repo (where polecat.yaml lives by
#                         default). Resolved by aops-core/lib/polecat_config.
#   AOPS_SRC_DIR          Convention root for project repos
#                         (`$AOPS_SRC_DIR/<repo>`).
#   AOPS_POLECAT_CONFIG   Explicit path to polecat.yaml. Overrides
#                         $AOPS_SESSIONS/polecat.yaml. The ONLY env var that
#                         *names* a config; every config *value* lives here.
#                         HOST-ONLY: polecat.yaml is no longer staged into
#                         containers, so this var is never set inside one.
#   POLECAT_HOME          Local cache root. The VALUE now lives in this file as
#                         the required `polecat_home:` key (the host SSoT). This
#                         env var is the CONTAINER TRANSPORT: the host resolves
#                         polecat_home and injects POLECAT_HOME so in-container
#                         lib/paths.py reads it. No ~/.polecat default anywhere.
#   ACA_DATA              Path to brain/PKB repo. Used by lib/paths.py.
#   AOPS_GHA_REPOS        Comma-separated list of repos to sync from GHA
#                         artifacts. Read by scripts/repo-sync-cron.sh.
#
# ─── Secrets (forwarded into containers via agent-env-map.conf) ────────────
#
#   AOPS_BOT_GH_TOKEN     Bot PAT for credential isolation (issue #581).
#                         Mapped to GH_TOKEN and GITHUB_TOKEN inside containers.
#   AOPS_CC_OAUTH_TOKEN      HOST source name for the Claude Code OAuth
#                            credential (aops-b368109a). The orchestrator
#                            (junior) holds ONLY this name; polecat injects its
#                            value into containers under the official name
#                            CLAUDE_CODE_OAUTH_TOKEN. Generate via
#                            `claude setup-token`. Indirection: lib/host_secrets
#                            ._FORWARD_SOURCE_ALIASES.
#   CLAUDE_CODE_OAUTH_TOKEN  CONTAINER name for the Claude Code OAuth credential.
#                            The ONLY supported Claude auth mechanism —
#                            `.credentials.json` and `ANTHROPIC_API_KEY` paths
#                            were removed (aops-06ab3ee0). Sourced from
#                            AOPS_CC_OAUTH_TOKEN on the host (official name kept
#                            as a transitional fallback source).
#   GEMINI_API_KEY        Gemini API auth.
#   PKB_MCP_URL           PKB MCP HTTP endpoint.
#   PKB_MCP_TOKEN         PKB MCP auth token.
#   PKB_MCP_TOOL_PREFIX   Prefix prepended to PKB MCP tool names to match the
#                         proxied server's namespace (default: pkb__; set
#                         empty for a direct pkb server).
#   AOPS_DIST_PAT         Distribution PAT for cross-repo workflow dispatches
#                         (GitHub Actions only).
#
# ─── Spawn-time runtime context (set by polecat/cli.py per session) ────────
#
#   AOPS_POLECAT_CONTAINER    "1" inside any polecat/crew container (set by
#                             polecat/cli.py at dispatch). Replaces the former
#                             POLECAT_SESSION_TYPE label (aops-b368109a): a
#                             resolved operational signal for state-dir routing
#                             and container-scoped gate posture, NOT a policy
#                             selector. Gate MODES are injected pre-resolved as
#                             *_GATE_MODE; the container reads no polecat.yaml.
#   POLECAT_CREW_NAME         Crew name for filenames. Also distinguishes a crew
#                             session from a run worker (its presence ⇒ crew).
#   POLECAT_APPROVAL_MODE     "plan" when launched in plan mode (signals the
#                             gate engine to skip the custodiet ops counter).
#   DEBUG_HOOKS               Materialised from `debug:` above. Router dumps
#                             raw hook stdin to /tmp/cc_hooks_<slug>.jsonl.
#   AOPS_ENABLED_PROVIDERS    Comma-separated enabled external_agents set,
#                             resolved on the host from `external_agents:` and
#                             injected so in-container lib/session_naming can
#                             parse artifact filenames WITHOUT reading
#                             polecat.yaml. Empty string ⇒ none enabled.
#   GEMINI_SESSION_ID         Set on the Gemini path; also a provider
#                             discriminator (Gemini CLI sets it itself when
#                             launched directly).
#   GEMINI_CLI_HOME           Gemini's ~/.gemini location. Polecat overrides
#                             to /home/worker for in-container auth staging.
#
# ─── Session-scoped (set by SessionStart hook, persisted via CLAUDE_ENV_FILE) ─
#
#   AOPS_SESSION_ID           Canonical, vendor-neutral session id. Set by
#                             aops-core/hooks/session_env_setup.py for Claude
#                             Code; set by polecat/cli.py for Gemini sessions
#                             (alongside GEMINI_SESSION_ID). This is the var
#                             skills, agents, and the gate engine reference.
#   AOPS_SESSION_STATE_DIR    Per-provider tmp dir holding session.json, hook
#                             JSONL, gate files.
#   AOPS_HOOK_LOG_PATH        Path to per-session hook JSONL.
#   AOPS_GATE_FILE_<NAME>     Per-gate file path overrides (HANDOVER, QA,
#                             ENFORCER, HYDRATION, IDA — five dynamic
#                             names). Lets in-session hook invocations share
#                             the same gate file.
#   PYTHONPATH                Includes aops-core/ so hooks can import lib.*.
#   PATH                      Augmented with uv/gh/etc by lib/path_bootstrap.
#   GIT_CONFIG_COUNT,         Force SSH→HTTPS rewrite + bot-PAT credential
#   GIT_CONFIG_KEY_*,         helper for github.com (defence in depth for
#   GIT_CONFIG_VALUE_*        credential isolation, issue #581).
#
# ─── Claude Code injected (we read; we do not set) ─────────────────────────
#
#   CLAUDE_PROJECT_DIR        Project root. Injected at hook execution time.
#   CLAUDE_ENV_FILE           File the SessionStart hook appends `export ...`
#                             lines to so subsequent tool calls see them.
#   CLAUDE_PLUGIN_ROOT        Plugin install path (templated into hook command
#                             lines and agent @-includes).
#   CLAUDE_AGENT_TYPE         Subagent type (set in spawned subagents).
#   CLAUDE_SUBAGENT_TYPE      Compliance subagent type.
#   CLAUDE_PARENT_SESSION_ID  Parent session linkage in spawned subagents.
#
# ─── Git/credential isolation literals (set by agent-env-map.conf in container) ─
#
#   GH_TOKEN, GITHUB_TOKEN          Mapped from AOPS_BOT_GH_TOKEN.
#   GIT_AUTHOR_NAME,                Bot identity literals.
#   GIT_AUTHOR_EMAIL,
#   GIT_COMMITTER_NAME,
#   GIT_COMMITTER_EMAIL
#   GIT_ASKPASS, GIT_SSH_COMMAND,   Block interactive prompts and SSH-key
#   GIT_TERMINAL_PROMPT,            access; force HTTPS+bot-PAT.
#   SSH_AUTH_SOCK
#   GIT_EDITOR                      Suppress interactive editor (set to "true").
#
# ─── Terminal / CI signals ─────────────────────────────────────────────────
#
#   CI, NONINTERACTIVE, COLORTERM, FORCE_COLOR, NO_COLOR,
#   GH_PROMPT_DISABLED, TZ, TMUX, NVM_DIR, NVM_BIN, DOCKER_HOST,
#   UV_CACHE_DIR, UV_INSTALL_DIR, UV_PROJECT_ENVIRONMENT
#
# ─── Optional per-host overrides ───────────────────────────────────────────
#
#   AOPS_MACHINE              Short machine name for artifact filenames. NO
#                             LONGER a loose outer-env var: set `machine:` in the
#                             <polecat_home>/local.yaml overlay; the host injects
#                             it into containers. Readers still fall back to
#                             `socket.gethostname()` when neither is set.
#   AOPS_TASK_ID              Task ID embedded in artifact filenames so they are
#                             task-greppable. SET by polecat/cli.py at dispatch
#                             (env["AOPS_TASK_ID"] = task.id) and read by
#                             lib/session_paths, transcript.py, insights_generator,
#                             subagent_transcript, transcript_parser, router. Live
#                             in production — do not assume it is test-only.
#   NTFY_TOPIC, NTFY_SERVER,  ntfy push notification config. Used by
#   NTFY_PRIORITY, NTFY_TAGS  hooks/ntfy_notifier.py. Could be folded into
#                             polecat.yaml in a future pass.
#   POLECAT_DOCKER_MEMORY     Container memory limit (override of CLI
#                             --memory). Could be folded into docker:.
#   POLECAT_TERMINATION_GRACE_SECONDS   Watchdog grace window override.
#
# ─── Test/dev opt-in flags ─────────────────────────────────────────────────
#
#   POLECAT_FORCE_STAGING            Force `cp` over bind-mount staging.
#   POLECAT_DISABLE_STARTUP_STAGGER  Skip startup-stagger sleep.
#   POLECAT_GEMINI_AUTH_DISABLED     Skip host-side Gemini auth check.
#   POLECAT_SKIP_PR_URL_CHECK        Skip live `gh` PR URL validation.
#   POLECAT_E2E, POLECAT_E2E_PROJECT, POLECAT_E2E_PARENT
#   POLECAT_GEMINI_HOST              Pre-staged Gemini home for sandbox tests.
#   HEALTH_THRESHOLD_CRITICAL,       Framework-health CLI thresholds.
#   HEALTH_THRESHOLD_WARNING
#   PYTEST_XDIST_WORKER              pytest-xdist worker id.
#
# ─── Template overrides (agent-side string replacement, low-traffic) ───────
#
#   HYDRATION_WARN_TEMPLATE, ENFORCER_CONTEXT_TEMPLATE,
#   ENFORCER_POLICY_CONTEXT_TEMPLATE, ENFORCER_INSTRUCTION_TEMPLATE,
#   STOP_GATE_HANDOVER_TEMPLATE
#
# ─── Removed (do not set; covered by the YAML above) ───────────────────────
#
#   HANDOVER_GATE_MODE, QA_GATE_MODE, ENFORCER_GATE_MODE,
#   HYDRATION_GATE_MODE, IDA_GATE_MODE, RBG_REVIEW_GATE_MODE
#                                          →  use `gates:` above.
#   ENFORCER_TOOL_CALL_THRESHOLD          →  use `gates.enforcer_threshold`.
#   ENFORCER_DISABLED                     →  use `gates.enforcer: off`.
#   POLECAT_SESSION_TYPE                  →  removed (aops-b368109a). The
#                                            container no longer self-identifies
#                                            with a policy label. Use
#                                            AOPS_POLECAT_CONTAINER (operational
#                                            signal) + POLECAT_CREW_NAME (crew
#                                            vs run); gate policy is injected
#                                            pre-resolved as *_GATE_MODE.
#   CLAUDE_SESSION_ID                     →  renamed to AOPS_SESSION_ID
#                                            (vendor-neutral; works for both
#                                            Claude Code and Gemini sessions).
#   AOPS_SESSION_STATE_PATH               →  dead. Hooks discover the state
#                                            file by scanning AOPS_SESSION_STATE_DIR.
#   POLECAT_WORKTREE                      →  dead. No reader.
#   AOPS_CLIENT_TYPE                      →  dead. Hydration template no
#                                            longer references it.
#   session_defaults / crew_defaults /    →  removed (note_296e5520 §4). Use
#   run_defaults (old overlay schema)        the four explicit `face:` /
#                                            `crew:` / `worker:` / `subagent:`
#                                            sections above — no overlay, no
#                                            shared base, no built-in default.
# ===========================================================================
