{
  "claude": {
    "mcpServers": {
      "pkb": {
        "type": "stdio",
        "command": "pkb",
        "args": ["mcp"],
        "env": {
          "ACA_DATA": "${user_config.ACA_DATA}",
          "RUST_LOG": "warn"
        }
      },
      "pkb-http": {
        "type": "http",
        "url": "${user_config.PKB_MCP_URL}"
      }
    }
  },
  "gemini": {
    "mcpServers": {
      "pkb": {
        "command": "pkb",
        "args": ["mcp"],
        "env": {
          "ACA_DATA": "${ACA_DATA}",
          "RUST_LOG": "warn"
        }
      }
    }
  }
}
