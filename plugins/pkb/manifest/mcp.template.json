{
  "manifestVersion": "1.0",
  "name": "aops-pkb",
  "clients": {
    "__base__": {
      "mcpServers": {}
    },
    "claude": {
      "mcpServers": {
        "services": {
          "type": "http",
          "url": "${user_config.pkb_mcp_url}"
        }
      }
    },
    "agy": {
      "mcpServers": {
        "services": {
          "command": "bash",
          "args": [
            "-c",
            "uvx --from fastmcp-slim[server] fastmcp run \"$PKB_MCP_URL\""
          ]
        }
      }
    }
  }
}
