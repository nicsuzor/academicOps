{
  "manifestVersion": "1.0",
  "name": "pkb",
  "clients": {
    "__base__": {},
    "claude": {
      "mcpServers": {
        "services": {
          "command": "bash",
          "args": [
            "-c",
            "uvx --from \"fastmcp-slim[server]\" fastmcp run \"$PKB_MCP_URL\""
          ]
        }
      }
    },
    "agy": {
      "mcpServers": {
        "services": {
          "command": "bash",
          "args": [
            "-c",
            "uvx --from \"fastmcp-slim[server]\" fastmcp run \"$PKB_MCP_URL\""
          ]
        }
      }
    }
  }
}
