{
  "__base__": {
    "mcpServers": {}
  },
  "claude": {
    "mcpServers": {
      "services": {
        "type": "http",
        "url": "${user_config.pkb_mcp_url}"
      }
    }
  },
  "agy": {
    "mcpServers": {
      "services": {
        "command": "bash",
        "args": ["${AGY_PLUGIN_ROOT}/scripts/run-mcp.sh"],
        "env": {
          "PKB_MCP_URL": "${PKB_MCP_URL}"
        }
      }
    }
  }
}
