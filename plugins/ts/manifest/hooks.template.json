{
  "__base__": {},
  "claude": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tailscale-up.sh\"",
              "timeout": 30
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end-sync.sh\"",
              "timeout": 300
            }
          ]
        }
      ]
    }
  }
}
