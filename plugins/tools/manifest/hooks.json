{
  "manifestVersion": "1.0",
  "name": "tools",
  "clients": {
    "__base__": {},
    "claude": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" claude SessionStart"
              }
            ]
          }
        ]
      }
    },
    "agy": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "uv run --project \"${AGY_PLUGIN_ROOT}\" python \"${AGY_PLUGIN_ROOT}/hooks/dispatch.py\" agy SessionStart"
              }
            ]
          }
        ]
      }
    }
  }
}
