{
  "manifestVersion": "1.0",
  "name": "aops-ida",
  "clients": {
    "__base__": {},
    "claude": {
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Agent",
            "hooks": [
              {
                "type": "command",
                "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" claude PostToolUse"
              }
            ]
          }
        ]
      }
    }
  }
}
