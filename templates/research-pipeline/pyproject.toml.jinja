[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
  { name = "{{ author_name }}" }
]
requires-python = ">=3.11"
dependencies = [
  "dbt-core>=1.8.0",
{% if sql_engine == 'duckdb' %}
  "dbt-duckdb>=1.8.0",
  "duckdb>=1.0.0",
{% elif sql_engine == 'bigquery' %}
  "dbt-bigquery>=1.8.0",
  "google-cloud-bigquery>=3.0.0",
{% endif %}
  "pyarrow>=14.0.0",
  "pandas>=2.0.0",
  "pyyaml>=6.0",
]

[project.optional-dependencies]
dev = [
  "pytest>=8.0.0",
  "ruff>=0.4.0",
]

[tool.uv]
package = false

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
