{
  "__base__": {},
  "claude": {
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\" claude PreToolUse"
            }
          ]
        }
      ]
    }
  },
  "agy": {
    "hooks": {
      "PostInvocation": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 \"${AGY_PLUGIN_ROOT}/hooks/dispatch.py\" agy PostInvocation"
            }
          ]
        }
      ]
    }
  }
}
